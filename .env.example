# Ejemplo de configuración local. Copiar a .env y reemplazar con los valores propios.
# Nunca subir .env al repositorio.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=laboratorio_1_bda
DB_USER=postgres
DB_PASSWORD=CAMBIAR_LOCALMENTE

# Backend (ajustar nombres al lenguaje y framework elegidos)
PORT=3000
JWT_SECRET=CAMBIAR_POR_UN_VALOR_SECRETO_Y_SEGURO

# Frontend (si se usa Vite; ajustar según framework)
VITE_API_URL=http://localhost:3000/api
